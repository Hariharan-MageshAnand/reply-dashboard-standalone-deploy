# Shared
NODE_ENV=development
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Backend
DATABASE_URL=postgresql://reply:reply@localhost:5433/reply_dashboard
REDIS_URL=redis://localhost:6380
PORT=4000
FRONTEND_URL=http://localhost:5180

# Mailbox OAuth — leave blank + MAILBOX_MOCK=true for local demos
MAILBOX_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/oauth/microsoft/callback

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api

# AI (Claude) — leave blank to run with fallbacks (classify -> Needs Review, drafts -> template)
ANTHROPIC_API_KEY=

# Approval flow email (Resend) — leave blank in dev: approve/change links print to the server log
RESEND_API_KEY=
EMAIL_FROM=

# Salesforce (username-password + security token; AWS: emergence/backend/salesforce-*)
# All four required to read SF context and create opportunities on booking.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=

# Meeting assignment desk — Google service account (base64 JSON) with domain-wide
# delegation for calendar.readonly (AWS: emergence/google/service-account).
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_MEETING_OWNER=meeting@emergence.com

# In-app meeting booking — writes to meeting@emergence.com's calendar via that
# user's OAuth refresh token (calendar.events). Same mechanism as the webapp;
# the service account only has read delegated. Client id/secret: AWS
# emergence/backend/google-client-id + -secret; refresh token from the webapp DB
# (webapp_production.user.google_refresh_token for meeting@emergence.com).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MEETING_OWNER_REFRESH_TOKEN=
